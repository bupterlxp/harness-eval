# CCR 的 OpenAI transformer 会直接 POST 到这个 URL，不会自动拼接 /chat/completions
# 所以需要填写完整的 chat completions 地址
base_url: "https://your-api-endpoint.example.com/v1/chat/completions"
api_key: "your-api-key-here"
model_name: "your-model-name-or-alias"

# 生成 harness 的 meta harness。可选：
# - claude-code: Docker 内运行 Claude Code + ccr，真实后端由 base_url/api_key/model_name 控制。
# - codex: 本机运行 Codex CLI，模型通过 Codex CLI 的 -m 参数控制。
meta_harness: "claude-code"

# Codex meta harness 的可选配置。
codex_bin: "codex"
codex_sandbox: "workspace-write"
codex_enable_search: false
# codex_extra_args: "--profile my-profile"

# Codex CLI 默认使用本机 Codex 登录态，模型名通常不是 OpenRouter ID。
# 如果你的 Codex profile 支持更多 provider，可以在这里覆盖。
codex_model_aliases:
  GPT5.5: "gpt-5.5"

# Claude Code CLI 只接受 Claude-family alias；真实后端请求仍由 model_name 决定。
claude_model_name: "claude-sonnet-4-6"

# 可选：Claude Code 的 --effort，以及 OpenRouter 的 verbosity。
# Opus 4.7 最强推理档用 "max"。
reasoning_effort: "max"

# 模型别名。命令行里的 --model-name / --eval-model-name 可以直接填这些短名，
# 也可以填真实 provider model id。下面是内置默认值的显式写法；如平台 ID 变化，
# 只需要在本地 config.yaml 里改这里，不需要改代码。
model_aliases:
  GPT5.5: "openai/gpt-5.5"
  Seed2.0: "ep-20260214145701-frz7j"
  Qwen3.7: "qwen/qwen3.7"
  Gemini3.1: "google/gemini-3.1"
  K2.6: "moonshotai/kimi-k2.6"
  GLM5.1: "z-ai/glm-5.1"
  Claude4.7: "anthropic/claude-opus-4.7"

# 下游 eval 时，被测 generated harness 调用的 LLM。
# 不填时，run.py 先查 configs/eval_llm_endpoints.yaml（按 eval_endpoint 选条目，
# 默认取文件里的 default），让 creation 阶段的 run_dev_bmk.py 一定有可用的
# eval LLM；其他测试模型的 endpoint 直接粘贴进那个文件即可。
# eval_endpoint: "gpt55-high"
# eval_endpoints_file: "./configs/eval_llm_endpoints.yaml"
# eval_base_url: "https://your-api-endpoint.example.com/v1/chat/completions"
# eval_api_key: "your-api-key-here"
# eval_model_name: "your-eval-model-name"
# eval_reasoning_effort: "max"

# 生成 prompt 默认采用 system_prompt + task_prompt。
system_prompt_file: "./prompts/system_prompt.md"
include_system_prompt: true

# 主实验 creation profile。RQ1 主 setting 推荐 claude_code_scaffold_native：
# 固定 Claude Code atomic scaffold/runtime，让模型主要设计 harness policy、编排、
# verifier、recovery 和 artifact 组织。
# 当前只保留 claude_code_scaffold_native 主路径。
creation_profile: "claude_code_scaffold_native"

# Creation 阶段给 meta harness + LLM 暴露公开/dev BMK feedback 命令。
# 这不是 validation gate，也没有外部 repair controller；模型自己决定是否调用
# run_dev_bmk.py、如何读分数/轨迹/日志、如何修改 harness、何时 FINISH。
enable_dev_bmk_feedback: true
dev_bmk_task_limit: 3
harness_evolve_root: "/Users/bytedance/Downloads/harness evolve project"

# Docker settings
max_concurrent: 4
# RQ1 正式 creation 默认不设 timeout；如需 pilot/debug 可临时设置分钟数。
timeout_minutes:
workspace_dir: "/workspace"
output_dir: "./outputs"
tasks_file: "./tasks.jsonl"
